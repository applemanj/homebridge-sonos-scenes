# Sonos OAuth credentials (from https://integration.sonos.com/integrations)
SONOS_CLIENT_ID=your-client-id
SONOS_CLIENT_SECRET=your-client-secret

# Must be publicly routable HTTPS URL pointing to this broker's /auth/callback
SONOS_REDIRECT_URI=https://your-broker.example.com/auth/callback

# Broker server settings
BROKER_PORT=8787
BROKER_HOST=0.0.0.0
BROKER_API_KEY=your-shared-api-key

# Secret for encrypting tokens at rest (auto-generated if not set)
BROKER_TOKEN_SECRET=

# Optional: docs URL shown on the login page
BROKER_DOCS_URL=https://github.com/applemanj/homebridge-sonos-scenes/blob/main/docs/cloud-broker.md
